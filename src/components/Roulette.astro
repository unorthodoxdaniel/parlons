---
import T from './T.astro';
import { ui } from '../i18n/ui';
import {
  DEFAULTS,
  PRACTICE_LANGUAGES,
  PREPARATION_SECONDS,
  RANDOM_THEME,
  SPEAKING_SECONDS,
  formatDuration,
} from '../lib/roulette';
---

<noscript><p><T k="noScript" /></p></noscript>
<div class="panel">
  <div class="sound-controls">
    <button type="button" id="sound-toggle" aria-pressed="false"><T k="soundOff" /></button>
    <p id="sound-status" role="status" hidden><T k="soundError" /></p>
  </div>
  <section class="settings" aria-labelledby="settings-heading">
    <h2 id="settings-heading" class="sr-only"><T k="settingsHeading" /></h2>

    <div class="fields">
      <div class="field">
        <label for="practice-language" class="eyebrow"><T k="practiceLanguage" /></label>
        <div class="select">
          <select id="practice-language" data-setting="practiceLang" autocomplete="off">
            <option value="" data-en={ui.en.chooseLanguage} data-fr={ui.fr.chooseLanguage}>{ui.en.chooseLanguage}</option>
            {PRACTICE_LANGUAGES.map((option) => (
              <option value={option.value} lang={option.value}>{option.label}</option>
            ))}
          </select>
        </div>
      </div>

      <div class="field">
        <label for="theme" class="eyebrow"><T k="theme" /></label>
        <div class="select">
          <select id="theme" data-setting="theme" autocomplete="off">
            <option value={RANDOM_THEME} data-en={ui.en.themeRandom} data-fr={ui.fr.themeRandom} selected>{ui.en.themeRandom}</option>
          </select>
        </div>
      </div>

      <div class="field">
        <label for="preparation" class="eyebrow"><T k="preparationTime" /></label>
        <div class="select">
          <select id="preparation" data-setting="preparationSeconds" autocomplete="off">
            {PREPARATION_SECONDS.map((seconds) => (
              <option value={seconds} selected={seconds === DEFAULTS.preparationSeconds} data-en={seconds === 0 ? ui.en.spontaneous : undefined} data-fr={seconds === 0 ? ui.fr.spontaneous : undefined}>
                {seconds === 0 ? ui.en.spontaneous : formatDuration(seconds)}
              </option>
            ))}
          </select>
        </div>
      </div>

      <div class="field">
        <label for="speaking" class="eyebrow"><T k="speakingTime" /></label>
        <div class="select">
          <select id="speaking" data-setting="speakingSeconds" autocomplete="off">
            {SPEAKING_SECONDS.map((seconds) => (
              <option value={seconds} selected={seconds === DEFAULTS.speakingSeconds}>{formatDuration(seconds)}</option>
            ))}
          </select>
        </div>
      </div>
    </div>
  </section>

  <section class="stage" aria-labelledby="stage-heading">
    <h1 id="stage-heading" class="eyebrow phase-heading" tabindex="-1"><T k="stageHeading" /></h1>

    <div id="stage-body" class="stage-body" role="status" aria-live="polite" aria-atomic="true">
      <p id="prompt-meta" class="meta" hidden></p>
      <span class="prompt-mark" aria-hidden="true">*</span>
      <p id="prompt-text" class="prompt-text" hidden></p>
      <p id="stage-note" class="stage-note"><T k="loading" /></p>
    </div>

    <div class="actions">
      <button type="button" id="retry" class="text-action primary" hidden><T k="retry" /></button>
      <button type="button" id="spin" class="text-action primary" aria-disabled="true"><T k="spin" /></button>
      <button type="button" id="session" class="text-action primary" aria-disabled="true" hidden></button>
    </div>
    <div id="session-controls" hidden>
      <p id="timer" role="timer" aria-live="off">10:00</p>
      <div id="timer-progress" class="timer-progress" aria-hidden="true"><span id="progress-fill"></span></div>
      <p id="paused" hidden><T k="paused" /></p>
      <div class="actions">
        <button id="pause" class="text-action" type="button"><T k="pause" /></button>
        <button id="advance" class="text-action primary" type="button"></button>
        <button id="cancel-session" class="text-action" type="button" hidden><T k="cancelSession" /></button>
      </div>
    </div>
    <div class="account-tools">
      <button id="hide-prompt" type="button" hidden><T k="hidePrompt" /></button>
      <p id="private-status" role="status"></p>
      <button id="replay-retry" type="button" hidden><T k="retry" /></button>
      <button id="save-retry" type="button" hidden><T k="saveRetry" /></button>
      <p id="hide-invite" hidden><T k="hideInvite" /> <a id="hide-sign-in" href="/auth/"><T k="signIn" /></a></p>
      <p id="history-invite" hidden><T k="historyInvite" /> <a href="/auth/"><T k="signIn" /></a></p>
    </div>
  </section>
</div>

<script>
  import {authClient} from '../lib/auth-client';
  import {hidePrompt, hiddenPromptIds} from '../lib/practice-data';
  import {INTENT_KEY, parseIntent, spokenMilliseconds, replaySettings, validSessionId} from '../lib/practice-rules';
  import { SessionSound } from '../lib/sound';
  import { Countdown, clockText } from '../lib/timer';
  import { createClient } from '@supabase/supabase-js';
  import { PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_PUBLISHABLE_KEY } from 'astro:env/client';
  import { bilingual, t, themeName, type UiKey } from '../i18n/ui';
  import {
    DEFAULTS,
    RANDOM_THEME,
    eligiblePrompts,
    initialPracticeLanguage,
    matches,
    pickPrompt,
    sessionAction,
    type Prompt,
    type Theme,
  } from '../lib/roulette';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const stageBody = $('stage-body');
  const metaEl = $('prompt-meta');
  const textEl = $('prompt-text');
  const noteEl = $('stage-note');
  const retryButton = $<HTMLButtonElement>('retry');
  const spinButton = $<HTMLButtonElement>('spin');
  const sessionButton = $<HTMLButtonElement>('session');
  const controls = $('session-controls');
  const heading = $('stage-heading');
  const timerEl = $('timer');
  const pauseButton = $<HTMLButtonElement>('pause');
  const advanceButton = $<HTMLButtonElement>('advance');
  const cancelButton = $<HTMLButtonElement>('cancel-session');
  const sound = new SessionSound();
  const soundButton = $<HTMLButtonElement>('sound-toggle');
  soundButton.addEventListener('click', async () => {
    if (sound.enabled) sound.disable();
    else {
      soundButton.disabled = true;
      const enabled = await sound.enable();
      soundButton.disabled = false;
      $('sound-status').hidden = enabled;
      if (enabled) sound.play('preparation'); // A brief preview confirms sound is on.
    }
    soundButton.innerHTML = t(sound.enabled ? 'soundOn' : 'soundOff');
    soundButton.setAttribute('aria-pressed', String(sound.enabled));
  });
  const pausedEl = $('paused');
  let phase: 'home' | 'preparation' | 'ready' | 'speaking' | 'finished' = 'home';
  const timer = new Countdown();
  let interval: ReturnType<typeof setInterval> | undefined;
  function stopTicking() { clearInterval(interval); interval = undefined; }
  function transition(next: typeof phase) {
    if (next === 'finished' && phase === 'speaking' && sessionRecord) {
      sessionRecord.completed_at=new Date().toISOString();
      sessionRecord.spoken_milliseconds = spokenMilliseconds(state.speakingSeconds, timer.remaining());
      void saveSession();
    }
    stopTicking();
    phase = next;
    if (next !== 'home') {stageBody.style.minHeight = '';textEl.style.fontSize = '';}
    if (next === 'preparation' || next === 'speaking') {
      timer.start(next === 'preparation' ? state.preparationSeconds : state.speakingSeconds);
      interval = setInterval(tick, 200);
      tick();
    }
    render();
    heading.focus();
  }
  function tick() {
    timerEl.textContent = clockText(timer.remaining());
    const duration = phase === 'preparation' ? state.preparationSeconds : state.speakingSeconds;
    $('progress-fill').style.width = `${duration > 0 ? 100 * (1 - timer.remaining() / (duration * 1000)) : 100}%`;
    if (timer.remaining() === 0) {
      sound.play(phase === 'preparation' ? 'preparation' : 'finished');
      transition(phase === 'preparation' ? 'ready' : 'finished');
    }
  }
  pauseButton.addEventListener('click', () => {
    if (sound.enabled) void sound.enable();
    if (timer.paused) timer.resume(); else timer.pause();
    tick(); render();
  });
  advanceButton.addEventListener('click', () => {
    if (phase === 'preparation') transition('ready');
    else if (phase === 'ready') {
      if (sound.enabled) void sound.enable();
      transition('speaking');
    }
    else if (phase === 'speaking') transition('finished');
    else if (phase === 'finished') {
      sessionRecord = null; privateMessage = null; $('private-status').textContent = '';
      state.prompt = null; state.cleared = false; automaticDrawPending=true; transition('home');drawInitialPrompt();
      practiceSelect.focus();
    }
  });
  cancelButton.addEventListener('click', () => {
    if (phase !== 'preparation' && phase !== 'ready' && phase !== 'speaking') return;
    // Leave through home so cancellation never records a completed session.
    sessionRecord = null;
    saving = false;
    saveFailed = false;
    privateStatus(null);
    transition('home');
    if (state.prompt) reservePromptSpace([state.prompt]);
    sessionButton.focus();
  });
  document.addEventListener('visibilitychange', () => {
    if (phase === 'preparation' || phase === 'speaking') tick();
  });
  const themeSelect = $<HTMLSelectElement>('theme');

  function uiLang() {
    return document.documentElement.dataset.uiLang === 'fr' ? 'fr' : 'en';
  }

  const practiceStorageKey='parlons:practice-lang';
  let savedPracticeLanguage: string | null=null;
  try {savedPracticeLanguage=localStorage.getItem(practiceStorageKey);}catch{}
  // Durations stay in memory; the explicit practice-language choice persists.

  const state = {
    load: 'loading' as 'loading' | 'ready' | 'error',
    prompts: [] as Prompt[],
    themes: [] as Theme[],
    // Browser fallback is independent of the interface-language switch.
    practiceLang: initialPracticeLanguage(savedPracticeLanguage, navigator.languages?.length ? navigator.languages : [navigator.language]),

    theme: DEFAULTS.theme,
    preparationSeconds: DEFAULTS.preparationSeconds,
    speakingSeconds: DEFAULTS.speakingSeconds,
    prompt: null as Prompt | null,
    cleared: false, // the last prompt was dropped because settings changed
    spinning: false,
  };

  const entryParams=new URLSearchParams(location.search);
  let settingsRevision=0;
  let automaticDrawPending=!entryParams.has('practice') && entryParams.get('restore')!=='hide';
  let userId: string | null = null;
  let accountVersion = 0;
  let preferences: 'loading' | 'ready' | 'error' = 'loading';
  let hiddenIds = new Set<number>();
  let privateMessage: UiKey | null = null;
  let saving = false;
  const pendingSaves=new Set<string>();
  let saveFailed = false;
  let hiding = false;
  let restoringHistory = false;
  let replayFailed = false;
  let replayId: string | null = new URLSearchParams(location.search).get('practice');
  function clearReplayUrl() {
    const url=new URL(location.href);url.searchParams.delete('practice');
    history.replaceState(null,'',url.pathname+url.search+url.hash);
  }
  async function restoreHistory() {
    if(!replayId || restoringHistory || state.load!=='ready' || preferences!=='ready')return;
    if(!userId || !validSessionId(replayId)){
      replayId=null;clearReplayUrl();privateStatus('replayUnavailable');render();return;
    }
    const owner=userId, version=accountVersion;
    restoringHistory=true;replayFailed=false;privateStatus('replayLoading');render();
    try {
      const {data,error}=await authClient.from('practice_sessions')
        .select('prompt_id, preparation_seconds, speaking_seconds')
        .eq('user_id',owner).eq('id',replayId).maybeSingle();
      if(version!==accountVersion)return;
      if(error)throw error;
      const prompt=data?state.prompts.find(p=>p.id===data.prompt_id):null;
      const settings=data?replaySettings(data):null;
      if(!prompt || !settings){replayId=null;clearReplayUrl();privateStatus('replayUnavailable');return;}
      // An intentional replay can use a hidden prompt without un-hiding it.
      Object.assign(state,settings,{practiceLang:prompt.lang,theme:prompt.theme,prompt,cleared:false});
      practiceSelect.value=prompt.lang;themeSelect.value=prompt.theme;
      $<HTMLSelectElement>('preparation').value=String(settings.preparationSeconds);
      $<HTMLSelectElement>('speaking').value=String(settings.speakingSeconds);
      replayId=null;clearReplayUrl();privateStatus('replayReady');
      reservePromptSpace([prompt]);heading.focus();
    }catch{if(version===accountVersion){replayFailed=true;privateStatus('replayError');}}
    finally{restoringHistory=false;render();}
  }
  $('replay-retry').addEventListener('click',()=>void restoreHistory());
  let sessionRecord: {id:string;user_id:string;prompt_id:number;preparation_seconds:number;speaking_seconds:number;spoken_milliseconds:number;completed_at?:string} | null = null;
  function privateStatus(key: UiKey | null) {
    privateMessage=key; $('private-status').innerHTML=key?t(key):'';
  }
  async function saveSession() {
    const record = sessionRecord;
    if (!record || record.user_id !== userId || pendingSaves.has(record.id)) return;
    pendingSaves.add(record.id);saving=true; saveFailed=false; privateStatus('historySaving'); render();
    try {
      const {error}=await authClient.from('practice_sessions').insert(record);
      if(error && error.code!=='23505')throw error;
      if(record===sessionRecord && record.user_id===userId)privateStatus('historySaved');
    } catch {
      if(record===sessionRecord && record.user_id===userId){saveFailed=true;privateStatus('historyError');}
    } finally {pendingSaves.delete(record.id);if(record===sessionRecord)saving=false;render();}
  }
  $('save-retry').addEventListener('click',()=>void saveSession());
  async function hideSelected() {
    const prompt=state.prompt; const owner=userId;
    if(!prompt || !owner || hiding)return;
    hiding=true; render();
    try {
      await hidePrompt(owner,prompt.id);
      if(owner!==userId)return;
      hiddenIds.add(prompt.id);privateStatus('hiddenSuccess');
    } catch {if(owner===userId)privateStatus('hideError');}
    finally{hiding=false;render();}
  }
  $('hide-prompt').addEventListener('click',()=>{
    if(userId)void hideSelected();
    else $('hide-invite').hidden=false;
  });
  $('hide-sign-in').addEventListener('click',(event)=>{
    if(!state.prompt)return;
    try{sessionStorage.setItem(INTENT_KEY,JSON.stringify({promptId:state.prompt.id,expires:Date.now()+15*60_000}));}
    catch{event.preventDefault();privateStatus('hideError');}
  });
  async function restoreIntent() {
    await restoreHistory();
    if(!userId || state.load!=='ready')return;
    const params=new URLSearchParams(location.search);
    if(params.get('restore')!=='hide')return;
    history.replaceState(null,'','/');
    let intent=null;
    try{intent=parseIntent(sessionStorage.getItem(INTENT_KEY));sessionStorage.removeItem(INTENT_KEY);}catch{}
    if(!intent){privateStatus('intentExpired');return;}
    const prompt=state.prompts.find(p=>p.id===intent.promptId);
    if(!prompt){privateStatus('hideError');return;}
    state.practiceLang=prompt.lang;practiceSelect.value=prompt.lang;state.theme=RANDOM_THEME;themeSelect.value=RANDOM_THEME;
    state.prompt=prompt;render();await hideSelected();heading.focus();
  }
  async function refreshAccount() {
    const version=++accountVersion;
    preferences='loading';render();
    try{
      const {data,error}=await authClient.auth.getUser();
      if(version!==accountVersion)return;
      const next=error?null:data.user?.id??null;
      if(next!==userId){sessionRecord=null;saveFailed=false;privateStatus(null);}
      userId=next;
      const loadedIds=userId?await hiddenPromptIds(userId):new Set<number>();
      if(version!==accountVersion)return;
      hiddenIds=loadedIds;
      preferences='ready';render();await restoreIntent();drawInitialPrompt();
    }catch{if(version===accountVersion){preferences='error';render();}}
  }
  authClient.auth.onAuthStateChange((event)=>{
    if(event==='SIGNED_OUT'){
      ++accountVersion;userId=null;hiddenIds.clear();preferences='ready';sessionRecord=null;saveFailed=false;
      $('hide-invite').hidden=true;privateStatus(null);render();
    }else if(event==='SIGNED_IN')setTimeout(()=>void refreshAccount(),0);
  });

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // --- Data ---------------------------------------------------------------

  const supabase = createClient(PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_PUBLISHABLE_KEY, { auth: { persistSession: false, autoRefreshToken: false, detectSessionInUrl: false } });

  async function readPrompts() {
    const rows: { id: number; text: string; languages: { code: string } | null; themes: { key: string } | null }[] = [];
    // Supabase limits each response; page through stable ids so every prompt
    // remains eligible rather than silently sampling the first page only.
    for (let offset = 0; ; offset += 500) {
      const result = await supabase.from('prompts')
        .select('id, text, languages(code), themes(key)').order('id')
        .range(offset, offset + 499).abortSignal(AbortSignal.timeout(15000));
      if (result.error) return { data: [], error: result.error };
      rows.push(...result.data);
      if (result.data.length < 500) return { data: rows, error: null };
    }
  }

  async function load() {
    state.load = 'loading';
    render();
    try {
    const [prompts, themes] = await Promise.all([
      readPrompts(),
      supabase.from('themes').select('key, name').order('id').abortSignal(AbortSignal.timeout(15000)),
    ]);
    if (prompts.error || themes.error) {
      // Keep failures recoverable without exposing service details.
      state.load = 'error';
    } else {
      state.prompts = prompts.data.flatMap((row) =>
        row.languages && row.themes
          ? [{ id: row.id, text: row.text, lang: row.languages.code, theme: row.themes.key }]
          : [],
      );
      state.themes = themes.data;
      state.load = 'ready';
      renderThemeOptions();
    }
    } catch { state.load = 'error'; }
    render();
    await restoreIntent();
    drawInitialPrompt();
  }

  // --- Controls -----------------------------------------------------------

  // <option> can't hold markup, so translated options carry data-en / data-fr
  // and are relabelled whenever the interface language changes.
  function labelOptions() {
    const lang = uiLang();
    document.querySelectorAll<HTMLOptionElement>('option[data-en]').forEach((option) => {
      option.textContent = option.dataset[lang] ?? option.dataset.en!;
    });
  }

  function renderThemeOptions() {
    themeSelect.querySelectorAll('[data-db-theme]').forEach((el) => el.remove());
    for (const theme of state.themes) {
      const names = themeName(theme.key, theme.name);
      const option = new Option(names.en, theme.key);
      option.dataset.dbTheme = '';
      option.dataset.en = names.en;
      option.dataset.fr = names.fr;
      themeSelect.append(option);
    }
    themeSelect.value = state.theme;
    labelOptions();
  }

  // A prompt that no longer fits the practice language or theme must not stay
  // on screen. Timer settings never invalidate it.
  function dropMismatchedPrompt() {
    if (state.prompt && !matches(state.prompt, state.practiceLang, state.theme)) {
      state.prompt = null;
      state.cleared = true;
    }
  }

  const practiceSelect = $<HTMLSelectElement>('practice-language');
  practiceSelect.value = state.practiceLang;

  document.querySelectorAll<HTMLSelectElement>('select[data-setting]').forEach((select) => {
    select.addEventListener('change', () => {
      const setting = select.dataset.setting as 'practiceLang' | 'theme' | 'preparationSeconds' | 'speakingSeconds';
      if (setting === 'practiceLang') {
        state.practiceLang = select.value;
        try {if(select.value)localStorage.setItem(practiceStorageKey,select.value);else localStorage.removeItem(practiceStorageKey);}catch{}

      } else if (setting === 'theme') state.theme = select.value;
      else state[setting] = Number(select.value);
      stageBody.style.minHeight = '';
      dropMismatchedPrompt();
      if(setting==='practiceLang'||setting==='theme'){$('hide-invite').hidden=true;privateStatus(null);}
      settingsRevision++;automaticDrawPending=true;
      render();drawInitialPrompt();
    });
  });

  // Interface language only relabels controls; practice language never changes.
  new MutationObserver(() => {
    labelOptions();

  }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-ui-lang'] });
  labelOptions();

  // --- Roulette -----------------------------------------------------------

  const eligible = () => eligiblePrompts(state.prompts, state.practiceLang, state.theme).filter(p=>!hiddenIds.has(p.id));
  function drawInitialPrompt() {
    if(!automaticDrawPending || phase!=='home' || !canSpin())return;
    void spin();
  }
  const canSpin = () => state.load === 'ready' && preferences === 'ready' && !state.spinning && !hiding && !restoringHistory && eligible().length > 0;

  function showPrompt(prompt: Prompt) {
    textEl.lang = prompt.lang; // the practice language, never the interface language
    // French sets a (non-breaking) space before ? ! : ; so they never wrap alone.
    textEl.textContent = prompt.lang === 'fr' ? prompt.text.replace(/ ([?!:;»])/g, ' $1') : prompt.text;
  }

  function wait(ms: number) {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }

  function reservePromptSpace(pool: Prompt[], shuffling = false) {
    // Fit only the selected prompt at reveal. The shuffle has its own compact,
    // fixed slot so intermediate frames cannot move the actions.
    stageBody.style.minHeight = '';
    textEl.style.fontSize = '';
    const panel = document.querySelector<HTMLElement>('.panel')!;
    const actions = panel.querySelector<HTMLElement>('.stage > .actions')!;
    const account = panel.querySelector<HTMLElement>('.account-tools')!;
    const footer = document.querySelector<HTMLElement>('footer')!;
    const below = actions.getBoundingClientRect().height + parseFloat(getComputedStyle(actions).marginTop)
      + account.getBoundingClientRect().height + parseFloat(getComputedStyle(account).marginTop)
      + parseFloat(getComputedStyle(panel).paddingBottom) + footer.getBoundingClientRect().height;
    const available = Math.max(0, window.innerHeight - (stageBody.getBoundingClientRect().top + window.scrollY) - below - 2);
    const measure = stageBody.cloneNode(true) as HTMLElement;
    measure.removeAttribute('id');measure.removeAttribute('role');measure.removeAttribute('aria-live');
    measure.setAttribute('aria-hidden', 'true');
    measure.querySelectorAll('[id]').forEach(el => el.removeAttribute('id'));
    Object.assign(measure.style, {
      position: 'fixed', left: '-10000px', top: '0', visibility: 'hidden',
      width: `${stageBody.getBoundingClientRect().width}px`, minHeight: '0',
    });
    const text = measure.querySelector<HTMLElement>('.prompt-text')!;
    const meta = measure.querySelector<HTMLElement>('.meta')!;
    text.hidden = meta.hidden = false;
    meta.textContent = themeName(pool[0]?.theme ?? '', '').en;
    measure.querySelector<HTMLElement>('.prompt-mark')!.style.display = 'block';
    measure.querySelector<HTMLElement>('.stage-note')!.hidden = true;
    stageBody.parentElement!.append(measure);
    const preferred = parseFloat(getComputedStyle(textEl).fontSize);
    // A rem-based floor preserves enlarged browser text instead of clipping it.
    const minimum = 1.5 * parseFloat(getComputedStyle(document.documentElement).fontSize);
    let size = Math.max(minimum, shuffling ? Math.min(preferred, 32) : preferred);
    function heightAt(fontSize: number) {
      text.style.fontSize = `${fontSize}px`;
      let height = 0;
      for (const prompt of pool) {
        text.lang = prompt.lang;
        text.textContent = prompt.lang === 'fr' ? prompt.text.replace(/ ([?!:;»])/g, ' $1') : prompt.text;
        height = Math.max(height, measure.getBoundingClientRect().height);
      }
      return height;
    }
    let height = heightAt(size);
    while (height > available && size > minimum) {
      size = Math.max(minimum, size - 1);
      height = heightAt(size);
    }
    measure.remove();
    textEl.style.fontSize = `${size}px`;
    stageBody.style.minHeight = `${Math.ceil(height)}px`;
  }

  async function spin() {
    if (!canSpin()) return;
    state.spinning=true;
    if (sound.enabled) await sound.enable();
    const pool = eligible();
    if(!pool.length || preferences!=='ready' || phase!=='home'){state.spinning=false;render();return;}
    const revision=settingsRevision;automaticDrawPending=false;
    const chosen = pickPrompt(pool, state.prompt)!;
    $('hide-invite').hidden=true;privateStatus(null);
    state.cleared = false;
    state.prompt = null;
    stageBody.setAttribute('aria-busy', 'true');
    render();
    reservePromptSpace(pool, true);

    // A short shuffle through eligible prompts, slowing to a stop. Skipped
    // entirely under prefers-reduced-motion.
    if (!reducedMotion.matches && pool.length > 1) {
      let last: Prompt | null = null;
      for (const delay of [70, 70, 80, 95, 115, 145, 190]) {
        const frame = pickPrompt(pool, last)!;
        last = frame;
        if (reducedMotion.matches || revision!==settingsRevision) break;
        sound.play('tick');
        showPrompt(frame);
        textEl.hidden = false;
        await wait(delay);
      }
    }

    // Settings can change mid-shuffle; never reveal a prompt that no longer fits.
    const stillFits = revision===settingsRevision && matches(chosen, state.practiceLang, state.theme) && !hiddenIds.has(chosen.id);
    state.spinning = false;
    state.prompt = stillFits ? chosen : null;
    if (stillFits) sound.play('reveal');
    state.cleared = !stillFits;
    stageBody.removeAttribute('aria-busy');
    render();
    if (state.prompt) {
      reservePromptSpace([state.prompt]);
      if (!reducedMotion.matches) textEl.animate([{ opacity: .45 }, { opacity: 1 }], { duration: 180 });
    }
    drawInitialPrompt();
  }

  spinButton.addEventListener('click', spin);
  window.addEventListener('resize', () => {
    if (phase === 'home' && !state.spinning) {
      stageBody.style.minHeight = '';
      if (state.prompt) reservePromptSpace([state.prompt]);
    }
  });

  // Start the selected session with its frozen settings.
  sessionButton.addEventListener('click', () => {
    if (sessionButton.getAttribute('aria-disabled') === 'true' || !state.prompt) return;
    if (sound.enabled) void sound.enable();
    sessionRecord=userId?{id:crypto.randomUUID(),user_id:userId,prompt_id:state.prompt.id,preparation_seconds:state.preparationSeconds,speaking_seconds:state.speakingSeconds,spoken_milliseconds:0}:null;
    saving=false;saveFailed=false; privateStatus(null);
    transition(state.preparationSeconds > 0 ? 'preparation' : 'speaking');
  });

  retryButton.addEventListener('click', ()=>{void load();void refreshAccount();});

  // --- Rendering ----------------------------------------------------------

  let noteKey: UiKey | null = null;
  function setNote(key: UiKey | null) {
    noteEl.hidden = key === null;
    if (key !== noteKey) {
      noteEl.innerHTML = key ? t(key) : '';
      noteKey = key;
    }
  }

  function setButtonLabel(button: HTMLElement, key: UiKey) {
    if (button.dataset.label !== key) {
      button.innerHTML = t(key);
      button.dataset.label = key;
    }
  }

  function render() {
    const active = phase !== 'home';
    $('replay-retry').hidden=!replayFailed || restoringHistory;
    document.querySelectorAll<HTMLSelectElement>('select[data-setting]').forEach(select=>select.disabled=restoringHistory);
    const hideButton=$<HTMLButtonElement>('hide-prompt');
    hideButton.hidden=!state.prompt || state.spinning || (phase!=='home' && phase!=='finished');
    hideButton.disabled=hiding || (!!state.prompt && hiddenIds.has(state.prompt.id));
    $('save-retry').hidden=!saveFailed || saving || phase!=='finished';
    $('history-invite').hidden=phase!=='finished' || !!userId;
    if(privateMessage)$('private-status').innerHTML=t(privateMessage);
    document.querySelector<HTMLElement>('.panel')!.dataset.phase = phase;
    document.querySelector<HTMLElement>('.panel')!.classList.toggle('has-prompt', !!state.prompt || state.spinning);
    document.querySelector<HTMLElement>('.settings')!.hidden = active;
    controls.hidden = !active;
    cancelButton.hidden = !active || phase === 'finished';
    heading.innerHTML = t(active ? phase : 'stageHeading');
    if (active) {
      spinButton.hidden = sessionButton.hidden = retryButton.hidden = true;
      metaEl.hidden = false; textEl.hidden = false;
      const running = phase === 'preparation' || phase === 'speaking';
      timerEl.hidden = pauseButton.hidden = $('timer-progress').hidden = !running;
      pausedEl.hidden = !running || !timer.paused;
      setButtonLabel(pauseButton, timer.paused ? 'resume' : 'pause');
      setButtonLabel(advanceButton, phase === 'preparation' ? 'skip' : phase === 'ready' ? 'startSpeaking' : phase === 'speaking' ? 'finish' : 'another');
      setNote(phase === 'finished' ? 'completeNote' : null);
      return;
    }
    const prompt = state.prompt;
    const options = eligible();

    // Prompt text and its note.
    metaEl.hidden = textEl.hidden = !prompt && !state.spinning;
    if (prompt) {
      showPrompt(prompt);
      const theme = state.themes.find((x) => x.key === prompt.theme);
      metaEl.innerHTML = theme ? bilingual(themeName(theme.key, theme.name)) : '';
    }
    if (prompt || state.spinning) {
      setNote(null);
      metaEl.hidden = !prompt;
    } else if (state.load === 'loading') setNote('loading');
    else if (state.load === 'error') setNote('loadError');
    else if (preferences === 'loading') setNote('hiddenLoading');
    else if (preferences === 'error') setNote('privateError');
    else if (state.prompts.length === 0) setNote('empty');
    else if (!state.practiceLang) setNote('needsLanguage');
    else if (options.length === 0) setNote(hiddenIds.size?'allHidden':'noMatch');
    else setNote(state.cleared ? 'cleared' : 'placeholder');

    textEl.classList.toggle('is-shuffling', state.spinning);
    retryButton.hidden = state.load !== 'error' && preferences !== 'error';

    // Roulette. Once a prompt exists the session action is primary and spinning
    // again is the quieter alternative.
    spinButton.hidden = state.load === 'error';
    spinButton.setAttribute('aria-disabled', String(!canSpin()));
    spinButton.classList.toggle('primary', !prompt);
    setButtonLabel(spinButton, prompt ? 'spinAgain' : 'spin');

    sessionButton.hidden = !prompt;
    sessionButton.setAttribute('aria-disabled', String(!prompt || state.spinning || restoringHistory));
    if (prompt) setButtonLabel(sessionButton, sessionAction(state.preparationSeconds) === 'prepare' ? 'prepare' : 'startSpeaking');
  }

  void load();
  void refreshAccount();
</script>

