---
import T from "./T.astro";
---
<footer class="site-footer site-shell">
  <span>© {new Date().getFullYear()} Parlons</span>
  <a href="/privacy/"><T k="privacy" /></a>
  <a href="/suggest/"><T k="suggest" /></a>
  <a href="https://nielparle.com">nielparle.com</a>
</footer>

<style>
  .site-footer {
    display: flex;
    justify-content: space-between;
    gap: 12px 30px;
    flex-wrap: wrap;
    align-items: center;
    padding: 22px 0 34px;
    border-top: 1px solid var(--ink);
    color: var(--muted);
    font-size: .72rem;
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  .site-footer a { min-height: 44px; display: inline-flex; align-items: center; }
  .site-footer a:hover { color: var(--ink); }
</style>
