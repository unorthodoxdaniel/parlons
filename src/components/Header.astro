---
import T from './T.astro';
---

<header class="site-header site-shell">
  <a class="brand" href="/">Parlons</a>

  <div class="header-controls">
    <a id="header-sign-in" class="account-action" href="/auth/" hidden><T k="signIn" /></a>
    <a id="header-account" class="account-action" href="/account/" hidden><T k="account" /></a>
    <button id="header-sign-out" class="account-action" type="button" hidden><T k="signOut" /></button>
  <div class="lang-switch meta" role="group" aria-labelledby="lang-switch-label">
    <span id="lang-switch-label" class="sr-only"><T k="interfaceLanguage" /></span>
    <button type="button" lang="fr" aria-label="Français" data-ui-lang-choice="fr" aria-pressed="false">FR</button>
    <span aria-hidden="true">/</span>
    <button type="button" lang="en" aria-label="English" data-ui-lang-choice="en" aria-pressed="true">EN</button>
  </div>
  </div>
</header>
<p id="header-auth-error" class="site-shell" role="alert" hidden><T k="signOutError" /></p>

<script>
  import {authClient} from '../lib/auth-client';
  const signIn = document.querySelector<HTMLElement>('#header-sign-in')!;
  const signOut = document.querySelector<HTMLButtonElement>('#header-sign-out')!;
  const authError = document.querySelector<HTMLElement>('#header-auth-error')!;
  function accountState(signedIn: boolean) {
    signIn.hidden = signedIn;
    signOut.hidden = !signedIn;
    document.querySelector<HTMLElement>('#header-account')!.hidden = !signedIn;
  }
  authClient.auth.onAuthStateChange((_event, session) => accountState(!!session));
  authClient.auth.getUser().then(({data}) => accountState(!!data.user)).catch(() => accountState(false));
  signOut.addEventListener('click', async () => {
    signOut.disabled = true; authError.hidden = true;
    try {
      const {error} = await authClient.auth.signOut({scope: 'local'});
      if (error) throw error;
      accountState(false);
    } catch {authError.hidden = false;}
    finally {signOut.disabled = false;}
  });

  // Persist an explicit interface-language choice. This only affects interface
  // strings; it never touches the language being practised.
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-ui-lang-choice]');
  const root = document.documentElement;

  const sync = () => {
    for (const button of buttons) {
      button.setAttribute('aria-pressed', String(button.dataset.uiLangChoice === root.dataset.uiLang));
    }
  };

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const lang = button.dataset.uiLangChoice!;
      root.dataset.uiLang = lang;
      root.lang = lang;
      try { localStorage.setItem('parlons:ui-lang', lang); } catch {}
      sync();
    });
  }

  sync();
</script>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 0 8px;
    border-bottom: 1px solid var(--ink);
  }

  .header-controls { display: flex; align-items: center; gap: 20px; }
  .account-action { min-height: 44px; display: inline-flex; align-items: center; font-size: .8rem; text-decoration: underline; text-underline-offset: .3em; }
  #header-auth-error { color: var(--error); font-size: .85rem; }
  @media(max-width:640px) { .header-controls { gap: 8px; } .account-action { font-size: .72rem; } }
  .brand {
    font-family: var(--serif);
    font-size: 1.45rem;
    font-style: italic;
    letter-spacing: -.03em;
  }

  .lang-switch {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  /* Subtle, but a 44px hit area. */
  .lang-switch button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    letter-spacing: inherit;
    text-transform: inherit;
  }

  .lang-switch button:hover { color: var(--ink); text-decoration: underline; text-underline-offset: .3em; }

  /* Selected state: ink, bold and underlined (not accent, not colour alone). */
  .lang-switch button[aria-pressed='true'] {
    color: var(--ink);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: .3em;
  }
</style>
