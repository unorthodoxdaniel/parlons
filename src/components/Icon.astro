---
interface Props { name: 'sun' | 'moon' | 'speaker'; }
const { name } = Astro.props;
---
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'sun' && <><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></>}
  {name === 'moon' && <path d="M20.5 14A9 9 0 0 1 10 3.5 9 9 0 1 0 20.5 14Z" />}
  {name === 'speaker' && <><path d="M11 5 6 9H3v6h3l5 4Z" /><g class="sound-waves"><path d="M15 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14" /></g><path class="sound-slash" d="m16 9 6 6m0-6-6 6" /></>}
</svg>
