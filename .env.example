PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Enable only after configuring and verifying the provider in Supabase.
PUBLIC_AUTH_GOOGLE=true
PUBLIC_AUTH_APPLE=false

# Public widget key only. Auth secret belongs in Supabase Auth settings;
# suggestions verification also needs a server-only Cloudflare TURNSTILE_SECRET_KEY.
PUBLIC_TURNSTILE_SITE_KEY=

# Public key for the anonymous suggestion form (separate from Auth).
PUBLIC_SUGGESTIONS_TURNSTILE_SITE_KEY=0x4AAAAAAFd4eiCj90agVd_N
